# FitTrack local development environment — template.
# Copy to `.env` at repo root and replace JWT_SECRET with a real value:
#
#   cp .env.example .env
#   sed -i '' "s|REPLACE_ME_RUN_openssl_rand_base64_32|$(openssl rand -base64 32)|" .env   # macOS
#   sed -i    "s|REPLACE_ME_RUN_openssl_rand_base64_32|$(openssl rand -base64 32)|" .env   # Linux
#
# `.env` is gitignored (holds secrets). This file is safe to commit — placeholders only.

# --- Database ---
# Defaults match docker-compose.yml so `docker compose up -d postgres` just works.
DB_URL=jdbc:postgresql://localhost:5432/fittrack
DB_USER=fittrack_user
DB_PASSWORD=fittrack_pass

# --- JWT ---
# MUST be base64-encoded, decodes to >=32 bytes. Generate one with:
#   openssl rand -base64 32
# The backend refuses to boot on known weak defaults (see JwtTokenProvider.java).
JWT_SECRET=REPLACE_ME_RUN_openssl_rand_base64_32
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Spring ---
SPRING_PROFILE=dev

# --- Server ---
SERVER_PORT=8080
